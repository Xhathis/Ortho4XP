# Faroe Islands orthophoto of Umhvørvisstovan (the Faroese environment agency),
# public ArcGIS WMS "myndakort_fotm" (no key). The old kortal.fo TMS redirects
# to a page and no longer serves tiles (2026-11-24).
# Outside the islands and their shore the layer is transparent, which a JPEG
# answer turns into white: use the combined provider FOA (this layer over the
# Faroe extent, Arc elsewhere) for whole tiles, not FO alone.
request_type=wms
wms_size=1024
epsg_code=3857
wms_version=1.1.1
url_prefix=https://gis.us.fo/arcgis/services/myndakort/myndakort_fotm/MapServer/WMSServer?
layers=1
max_threads=4
extent=Faroe
imagery_dir=code
in_GUI=False
